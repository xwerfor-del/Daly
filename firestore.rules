rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // كل مستخدم يقرأ ويكتب بياناته هو فقط
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // سعر الليرة: يقرؤه الجميع، ويكتبه المدير فقط
    match /public/rates {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "ضع-إيميلك-هنا@gmail.com";
    }
  }
}
